# Copy to .env and fill in your account credentials. Never commit .env.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
ACCESS_ALLOWED_EMAILS=you@example.com

# Only needed if your account has no workers.dev subdomain:
# WORKERS_SUBDOMAIN=your-unique-subdomain

# Optional:
# WORKER_NAME=sourcemetric
# GITHUB_TOKEN=your-github-token

# Optional custom hostname in an active Cloudflare zone in this account:
# CUSTOM_DOMAIN=metrics.example.com
